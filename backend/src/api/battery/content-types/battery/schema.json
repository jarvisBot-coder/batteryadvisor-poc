    "expandable": {
      "type": "boolean",
      "default": false
    },
    "phase": {
      "type": "enumeration",
      "enum": [
        "mono",
        "tri",
        "both"
      ],
      "default": "mono"
    },
    "configurations": {
      "type": "json"
    },
    "video_url": {
      "type": "string",
      "maxLength": 255
    },
    "reviews": {
      "type": "json"
    },
