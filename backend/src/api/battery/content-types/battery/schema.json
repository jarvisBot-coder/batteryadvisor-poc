{
  "kind": "collectionType",
  "collectionName": "batteries",
  "info": {
    "singularName": "battery",
    "pluralName": "batteries",
    "displayName": "Battery",
    "description": "Batteries domestiques plug-in pour le marché belge"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "inversedBy": "batteries"
    },
    "capacity_kwh": {
      "type": "decimal"
    },
    "power_watts": {
      "type": "integer"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "plug-in",
        "hybrid",
        "off-grid"
      ],
      "default": "plug-in"
    },
    "score_overall": {
      "type": "decimal",
      "min": 0,
      "max": 10
    },
    "score_performance": {
      "type": "decimal",
      "min": 0,
      "max": 10
    },
    "score_app": {
      "type": "decimal",
      "min": 0,
      "max": 10
    },
    "score_value": {
      "type": "decimal",
      "min": 0,
      "max": 10
    },
    "score_installation": {
      "type": "decimal",
      "min": 0,
      "max": 10
    },
    "score_quality": {
      "type": "decimal",
      "min": 0,
      "max": 10
    },
    "price_from": {
      "type": "decimal"
    },
    "warranty_years": {
      "type": "integer"
    },
    "weight_kg": {
      "type": "decimal"
    },
    "chemistry": {
      "type": "string",
      "maxLength": 100
    },
    "cycles": {
      "type": "integer"
    },
    "belgium_approved": {
      "type": "boolean",
      "default": false
    },
    "badge": {
      "type": "enumeration",
      "enum": [
        "coup-de-coeur",
        "meilleure-puissance",
        "meilleur-budget",
        "none"
      ],
      "default": "none"
    },
    "pros": {
      "type": "json"
    },
    "cons": {
      "type": "json"
    },
    "verdict": {
      "type": "text"
    },
    "review_body": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "shops": {
      "type": "json"
    },
    "features": {
      "type": "json"
    },
    "published_at_date": {
      "type": "date"
    }
  }
}
